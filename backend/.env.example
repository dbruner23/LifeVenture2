# Local dev defaults match docker-compose.yml — copy to .env only if you need
# to override. The code falls back to these values when unset.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lifeventure
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
# Local dev server port
PORT=3000

# In AWS Lambda these are set by CDK instead, plus:
# DB_IAM_AUTH=true   (generate an RDS IAM token instead of using DB_PASSWORD)
# DB_SSL=true
# AWS_REGION=ap-southeast-2
